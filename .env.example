# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Everything runs without these: corroboration replays recorded cassettes,
# tracing records locally, and the careers-page check uses a local browser.
# The keys turn each of those live.

# app.tavily.com/redeem/HIRINGHACK
TAVILY_API_KEY=

# prism.blockconvey.com — redeem HACKBUILDER#3 under Billing,
# then Settings -> API Keys. BOTH values are required.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
# Only if your PRISM brief names a host other than the SDK default.
PRISMTRACE_HOST=

# console.getsolari.com — Billing -> HRHACK2026-DHKB2CEH
SOLARI_API_KEY=

# Optional: live Tavily responses are recorded here as reusable fixtures.
# GROUNDTRUTH_RECORD_DIR=backend/tests/cassettes
