# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Must be PLAIN TEXT. TextEdit on macOS saves .rtf by default; if you already
# made one, convert it:  textutil -convert txt keys.rtf -output .env
#
#   cp .env.example .env
#
# Everything runs without these: corroboration replays recorded cassettes,
# tracing records locally, and the careers-page check uses a local browser.
# The keys turn each of those live.

# app.tavily.com/redeem/HIRINGHACK
TAVILY_API_KEY=

# prism.blockconvey.com — redeem HACKBUILDER#3 under Billing,
# then Settings -> API Keys. BOTH values are required.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
# Only if your PRISM brief names a host other than the SDK default.
PRISMTRACE_HOST=

# console.getsolari.com — Billing -> HRHACK2026-DHKB2CEH
SOLARI_API_KEY=

# Optional: live Tavily responses are recorded here as reusable fixtures.
# GROUNDTRUTH_RECORD_DIR=backend/tests/cassettes

# --- Public deployment hardening --------------------------------------------
# All optional. Sane defaults apply when unset (see groundtruth/config.py).

# Requests per client per minute at /api/verify and /api/verify/stream.
# RATE_LIMIT_PER_MINUTE=20

# Hard cap on an uploaded offer letter, in megabytes.
# MAX_UPLOAD_MB=15

# Comma-separated origins allowed to call the API cross-site. Unset means
# '*' (open), which is fine for the public demo and wrong once an
# institutional customer embeds this against their own domain.
# ALLOWED_ORIGINS=https://issso.youruniversity.edu,https://career.youruniversity.edu
