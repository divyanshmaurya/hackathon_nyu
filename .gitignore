__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.local
node_modules/
dist/
.DS_Store

# Signing keys never belong in a repository, including demo ones.
# Regenerate fixtures with backend/tests/registry/make_registry.py
*.pem
!*.pub.pem

# Credential files people actually create by hand. The loader only reads
# .env/.env.local, but a file named "keys" or "secrets.txt" is exactly what
# someone makes while setting up, and nothing else here would stop it being
# committed.
keys
keys.*
secrets
secrets.*
credentials
credentials.*
*.env
*_key
*_keys
api_key*
api-keys*
